# Copy to /etc/myapp.env on the VM and fill in real values.
# `chmod 600 /etc/myapp.env && chown myapp:myapp /etc/myapp.env`

NODE_ENV=production
PORT=3000
DB_PATH=/var/lib/myapp/app.db

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string

# Set to "true" only after enabling HTTPS — secure cookies are not sent over plain HTTP,
# so flipping this too early breaks login.
SECURE_COOKIES=false
